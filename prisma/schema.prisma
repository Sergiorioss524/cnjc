// Prisma schema — CNJ Bolivia
// Usa Postgres (ej. Neon, Vercel Postgres o Supabase) para que la app
// funcione en Vercel, cuyo filesystem serverless no puede alojar SQLite.

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Postulacion {
    id        String @id @default(cuid())
    categoria String

    // Campos comunes
    nombre    String
    email     String
    telefono  String
    ciudad    String

    // Campos específicos de "Emprendedor" (null si no aplica)
    empresa      String?
    nit          String?
    antiguedad   String?

    // Campos específicos de "Profesional" (null si no aplica)
    profesion    String?
    experiencia  Int?

    // Campos específicos de "Universitario" (null si no aplica)
    universidad  String?
    carrera      String?
    semestre     String?

    estado    String   @default("PENDIENTE")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([email])
    @@index([categoria])
}
