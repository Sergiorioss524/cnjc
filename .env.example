# Copia este archivo a ".env" y ajusta los valores.

# Postgres (ej. Neon, Vercel Postgres o Supabase). Crea una base gratuita
# y pega aquí la connection string que te den.
DATABASE_URL="postgresql://user:password@host:5432/cnj"

# Secreto para firmar las sesiones del backoffice (/admin). Genera uno con:
# openssl rand -base64 32
AUTH_SECRET=""

# Solo necesarios al correr `pnpm run db:seed` para crear/actualizar el
# primer usuario admin del backoffice. No se guardan en la base de datos
# en texto plano (se hashean con bcrypt) y no deben commitearse.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
